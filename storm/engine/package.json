{
  "name": "noised-storm",
  "version": "1.0.0-beta.1",
  "description": "NoiseD Storm: procedural rain with Rust/WebAssembly and layered Web Audio thunder.",
  "license": "ISC",
  "author": "David Portal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stargazingdave/noised-web.git",
    "directory": "storm/engine"
  },
  "homepage": "https://github.com/stargazingdave/noised-web/tree/main/storm/engine#readme",
  "bugs": "https://github.com/stargazingdave/noised-web/issues",
  "keywords": ["audio", "rain", "thunder", "procedural-audio", "web-audio", "wasm"],
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rain.worklet.js": "./dist/worklet/rain.worklet.js",
    "./noised_dsp.wasm": "./dist/wasm/noised_dsp.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:wasm",
    "build:js": "tsup src/index.ts --dts --format esm,cjs --out-dir dist --clean && tsup src/worklet/rain.worklet.ts --format esm --out-dir dist/worklet",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && cargo test --workspace --locked",
    "test:browser": "npm run build && node tests/browser-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "bench": "npm run build && node scripts/bench-rain.mjs",
    "dev": "tsup src/index.ts --dts --format esm,cjs --sourcemap --watch",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
