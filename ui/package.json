{
  "name": "noised-ui",
  "version": "1.0.0-beta.1",
  "description": "NoiseD UI: React audio controls with automatic scoped styling.",
  "license": "ISC",
  "author": "David Portal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stargazingdave/noised-web.git",
    "directory": "ui"
  },
  "homepage": "https://github.com/stargazingdave/noised-web/tree/main/ui#readme",
  "bugs": "https://github.com/stargazingdave/noised-web/issues",
  "keywords": ["react", "audio", "knob", "equalizer", "visualization", "web-audio"],
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./unstyled": {
      "import": {
        "types": "./dist/unstyled.d.ts",
        "default": "./dist/unstyled.js"
      },
      "require": {
        "types": "./dist/unstyled.d.cts",
        "default": "./dist/unstyled.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
